<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE properties SYSTEM "http://java.sun.com/dtd/properties.dtd">
<properties>
  <comment>jdbgen - Korean translation of i18n/common.xml. The key set has to stay identical to the English original.</comment>

  <!-- generic dialog chrome -->
  <entry key="common.dialog.error.title">오류</entry>
  <entry key="common.dialog.info.title">알림</entry>
  <entry key="common.button.cancel">취소</entry>

  <!-- password prompt -->
  <entry key="common.password.label">비밀번호:</entry>
  <entry key="common.password.confirm.label">확인:</entry>
  <entry key="common.password.mismatch">비밀번호와 확인 값이 일치하지 않습니다.</entry>

  <!-- shared UI helpers -->
  <entry key="common.validation.required">''{0}'' 항목은 반드시 입력해야 합니다.</entry>
  <entry key="common.filechooser.imageFilter">이미지/아이콘 파일</entry>
  <entry key="common.template.tooltip">템플릿 이름  : {0}&#10;템플릿 파일  : {1}&#10;출력 파일명  : {2}</entry>

  <!-- update check and download -->
  <entry key="common.update.title">업데이트 있음</entry>
  <entry key="common.update.available">새 버전 {0}을(를) 사용할 수 있습니다.&#10;지금 업데이트하시겠습니까?</entry>
  <entry key="common.update.failed">업데이트를 자동으로 설치하지 못했습니다.</entry>
  <entry key="common.update.openReleasePage">릴리스 페이지를 열어 직접 내려받으시겠습니까?</entry>
  <entry key="common.update.progress.title">jdbgen 업데이트</entry>
  <entry key="common.update.progress.downloading">{0} 내려받는 중</entry>

  <!-- loading and saving the configuration -->
  <entry key="common.config.password.enter">마스터 비밀번호를 입력하세요</entry>
  <entry key="common.config.password.new">새 마스터 비밀번호를 입력하세요</entry>
  <entry key="common.config.password.incorrect">비밀번호가 올바르지 않습니다!</entry>
  <entry key="common.config.error.title">설정 오류</entry>
  <entry key="common.config.error.message">{0}번 시도했지만 설정을 열지 못했습니다.&#10;&#10;마지막 오류: {1}&#10;&#10;마스터 비밀번호가 틀렸을 가능성이 가장 높습니다. 설정 파일은 변경되지 않았습니다.&#10;&#10;[확인] 비밀번호를 다시 입력합니다&#10;[취소] 기본 설정으로 시작합니다</entry>
  <entry key="common.config.default.title">기본 설정으로 시작</entry>
  <entry key="common.config.default.message">기본 설정을 새로 만들고 새 마스터 비밀번호를 입력받습니다.&#10;&#10;현재 설정은 삭제되지 않고 ''{0}'' 옆에 백업 파일로 보관됩니다.&#10;&#10;계속하시겠습니까?</entry>
  <entry key="common.config.default.loadFailed">기본 설정을 불러올 수 없습니다: {0}</entry>
  <entry key="common.config.backup.failed">기존 설정 ''{0}''을(를) 백업하지 못해 그대로 두었습니다.&#10;해당 디렉터리의 파일 권한을 확인한 뒤 다시 실행하세요.</entry>
  <entry key="common.config.backup.kept">기존 설정을 다음 위치에 보관했습니다:&#10;{0}&#10;&#10;파일 이름을 ''{1}''(으)로 되돌리면 복원됩니다.</entry>
  <entry key="common.config.write.failed">기본 설정을 ''{0}''에 기록하지 못했습니다.</entry>
  <entry key="common.config.write.restored">&#10;&#10;이전 설정이 변경 없이 그대로 유지되었습니다.</entry>
  <entry key="common.config.write.keptBackup">&#10;&#10;이전 설정은 다음 위치에 보관되어 있습니다:&#10;{0}&#10;&#10;파일 이름을 ''{1}''(으)로 되돌리면 복원됩니다.</entry>
  <entry key="common.config.save.failed">설정을 저장할 수 없습니다: {0}</entry>

  <!-- language selection in the main window -->
  <entry key="common.language.system">시스템 기본값</entry>
  <entry key="common.language.tooltip">사용자 인터페이스 언어, 다시 시작한 뒤 적용됩니다</entry>
  <entry key="common.language.restartRequired">언어 설정은 jdbgen을 다시 시작한 뒤에 적용됩니다.</entry>
</properties>
