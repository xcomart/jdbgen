  <entry key="mavenExplorer.msg.noMoreResults">검색 결과가 더 없습니다.</entry>
  <entry key="mavenExplorer.msg.noMoreVersions">버전이 더 없습니다.</entry>
  <entry key="mavenExplorer.msg.selectVersion">내려받을 버전을 선택하세요.</entry>
  <entry key="mavenExplorer.msg.downloadComplete">내려받기가 완료되었습니다!</entry>
  <entry key="mavenExplorer.msg.downloadFailed">내려받기에 실패했습니다!</entry>

  <!-- 내려받기 진행 로그 -->
  <entry key="mavenExplorer.progress.saving">드라이버를 {0} 에 저장하는 중...</entry>
  <entry key="mavenExplorer.progress.received">{0}/{1} 바이트를 받았습니다.</entry>
  <entry key="mavenExplorer.progress.complete">내려받기를 마쳤습니다.</entry>
  <entry key="mavenExplorer.progress.failed">내려받기 실패! : {0}</entry>
</properties>
