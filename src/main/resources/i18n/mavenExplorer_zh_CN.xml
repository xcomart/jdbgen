<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE properties SYSTEM "http://java.sun.com/dtd/properties.dtd">
<properties>
  <comment>jdbgen - Simplified Chinese translation of i18n/mavenExplorer.xml. The key set has to stay identical to the English original.</comment>

  <!-- window and search -->
  <entry key="mavenExplorer.title">Maven 仓库浏览器</entry>
  <entry key="mavenExplorer.jLabel1.text">在 Maven 仓库中搜索：</entry>

  <!-- result lists -->
  <entry key="mavenExplorer.jLabel3.text">搜索结果</entry>
  <entry key="mavenExplorer.jLabel4.text">版本</entry>
  <entry key="mavenExplorer.btnMore.text">更多</entry>
  <entry key="mavenExplorer.btnMore1.text">更多</entry>

  <!-- buttons and credit -->
  <entry key="mavenExplorer.btnDownload.text">下载并使用</entry>
  <entry key="mavenExplorer.btnCancel.text">取消</entry>
  <entry key="mavenExplorer.jLabel2.text">技术支持</entry>

  <!-- messages -->
  <entry key="mavenExplorer.msg.noMoreResults">没有更多结果</entry>
  <entry key="mavenExplorer.msg.noMoreVersions">没有更多版本</entry>
  <entry key="mavenExplorer.msg.selectVersion">请选择要下载的版本。</entry>
  <entry key="mavenExplorer.msg.downloadComplete">下载完成！</entry>
  <entry key="mavenExplorer.msg.downloadFailed">下载失败！</entry>

  <!-- download progress log -->
  <entry key="mavenExplorer.progress.saving">正在将驱动保存到 {0}...</entry>
  <entry key="mavenExplorer.progress.received">已接收 {0}/{1} 字节。</entry>
  <entry key="mavenExplorer.progress.complete">下载完成。</entry>
  <entry key="mavenExplorer.progress.failed">下载失败！：{0}</entry>
</properties>
