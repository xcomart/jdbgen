<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE properties SYSTEM "http://java.sun.com/dtd/properties.dtd">
<properties>
  <comment>jdbgen - Japanese translation of i18n/tableView.xml. The key set has to stay identical to the English original.</comment>

  <!-- header, filled with the selected table at runtime -->
  <entry key="tableView.lblTableName.text">テーブル名</entry>
  <entry key="tableView.lblRemark.text">説明</entry>

  <!-- column table -->
  <entry key="tableView.column.name">名前</entry>
  <entry key="tableView.column.type">型</entry>
  <entry key="tableView.column.key">キー</entry>

  <entry key="tableView.btnClose.text">閉じる</entry>
</properties>
